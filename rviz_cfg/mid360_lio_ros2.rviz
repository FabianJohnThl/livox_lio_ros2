    Name: Displays
    Property Tree Widget:
      Expanded:
        - /odometry1
        - /mapping1
        - /LaserScan1
        - /LaserScan1/Topic1
      Splitter Ratio: 0.5225988626480103
    Tree Height: 787
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Pose Estimate1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.49433961510658264
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: LaserScan
Visualization Manager:
  Class: ""
  Displays:
